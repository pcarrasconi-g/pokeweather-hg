# Copia a .env y define valores reales. No subas .env al repositorio.
# Obligatoria: contraseña de PostgreSQL (genera una aleatoria, p. ej. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me-placeholder
# Opcionales
POSTGRES_USER=pokeweather
POSTGRES_DB=pokeweather
# Puerto en 127.0.0.1 donde se publica la web
WEB_PORT=8731
